# StayHub Server — Environment Variables

# PostgreSQL connection string (replace with your actual Postgres URL)
# Examples:
#   Local:    postgresql://user:password@localhost:5432/stayhub
#   Supabase: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
#   Neon:     postgresql://[user]:[password]@[endpoint].neon.tech/stayhub?sslmode=require
#   Railway:  postgresql://postgres:[password]@[host].railway.app:5432/railway
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/stayhub?connection_limit=10 # on a small EC2 instance the Prisma pool should be sized to stay under Postgres's max_connections

RATE_LIMIT_STORE=memory   # "memory" or "redis" — set to redis if running Node in PM2 cluster mode
REDIS_URL=                # only required if RATE_LIMIT_STORE=redis
TRUST_PROXY=1             # set to 1 when running behind Nginx on the same EC2 instance

#cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

#nodemailer
SENDER_EMAIL=
SMTP_USER=
SMTP_PASS=

#stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PORT=5000
