// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  user
  admin
  hotelOwner
}

enum PaymentMethod {
  PAY_AT_HOTEL
  STRIPE
}

enum BookingStatus {
  pending
  payment_pending
  confirmed
  cancelled
  refunded
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  // Internal UUID primary key — keeps FK relationships stable and type-uniform.
  id      String   @id @default(uuid())

  username             String
  email                String   @unique
  image                String   @default("")
  role                 UserRole @default(user)

  // Self-hosted auth fields
  passwordHash         String
  isVerified           Boolean  @default(false)
  otp                  String?  // bcrypt hash of the 6-digit OTP
  otpExpiry            DateTime?

  // Simple capped array (max 3 in application logic). Native Postgres text[]
  // is sufficient — no JSONB overhead needed for a flat string list.
  recentSearchedCities String[] @default([])

  // ── Task 8: Essential Guest Auditing ──────────────────────────────────────
  // Optional fields — not required at registration. Collected before/during booking.
  firstName  String?
  lastName   String?
  phone      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotels   Hotel[]
  bookings Booking[]
}

model Hotel {
  id      String @id @default(uuid())
  name    String
  address String
  contact String
  city    String

  // FK to User.id (UUID), not User.clerkId, for relational integrity.
  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  @@unique([ownerId])
  @@index([city])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 3: separate marketing data (RoomType) from physical inventory (Room)
  roomTypes RoomType[]
  bookings  Booking[]
}

// ---------------------------------------------------------------------------
// Phase 3 — Inventory Architecture
//
// RoomType: marketing data — what the guest sees and books.
//   • One RoomType can have N physical Rooms (e.g., 5 "Deluxe King" rooms).
//   • The guest selects a RoomType; the backend assigns any available Room.
//
// Room: physical inventory — the actual doors the hotel manages.
//   • Guests never see room numbers; they are internal to the hotel.
//   • Created in bulk when the owner adds a room type with a given quantity.
// ---------------------------------------------------------------------------

model RoomType {
  id      String @id @default(uuid())
  hotel   Hotel  @relation(fields: [hotelId], references: [id])
  hotelId String

  // Marketing display name — e.g. "Single Bed", "Luxury Suite"
  name          String
  pricePerNight Decimal @db.Decimal(10, 2)

  // Both amenities and images are flat string arrays — no child table needed
  // because neither is ever filtered/joined on individual elements.
  amenities String[] @default([])
  images    String[] @default([])

  // ── Task 8: max guests capacity for this room type ──────────────────────
  maxGuests Int @default(2)

  // Owner-level toggle — hides this room type from listings entirely.
  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory RoomTypeInventory[]
  bookings  Booking[]

  @@index([hotelId])
  @@index([isAvailable])
}

model RoomTypeInventory {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  roomType    RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  roomTypeId  String
  totalRooms  Int
  bookedRooms Int      @default(0)

  @@unique([date, roomTypeId])
  @@index([roomTypeId])
  @@index([date])
}

model Booking {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  // RoomType stored for display queries (avoids an extra join on every list).
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  roomTypeId String

  hotel   Hotel  @relation(fields: [hotelId], references: [id])
  hotelId String

  checkInDate  DateTime
  checkOutDate DateTime

  totalPrice Decimal @db.Decimal(10, 2)
  guests     Int

  status BookingStatus @default(pending)

  paymentMethod PaymentMethod @default(PAY_AT_HOTEL)
  isPaid        Boolean       @default(false)

  stripeSessionId     String?
  stripePaymentIntent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime?

  // ---------------------------------------------------------------------------
  // Overlapping booking prevention relies on the RoomTypeInventory counts.
  // ---------------------------------------------------------------------------

  @@index([checkInDate, checkOutDate])
  @@index([roomTypeId])
  @@index([userId])
  @@index([hotelId])
  @@index([status])
}
